# Application Settings
APP_NAME="Document Understanding API"
APP_VERSION="1.0.0"
DEBUG=False

# Paths (optional - will use defaults if not set)
# OUTPUT_DIR="ocr_output"
# DB_PATH="db_chromadb"
# TEMP_DIR="temp"

# OCR Settings
# OCR_DPI=200
# SKIP_FIRST_N_PAGES=3

# Embedding Settings
# EMBEDDING_MODEL="Qwen/Qwen3-Embedding-0.6B"
# COLLECTION_NAME="documents"

# Retrieval Settings
# RETRIEVAL_TOP_K=50
# RERANK_TOP_K=5
# RERANKER_MODEL="BAAI/bge-reranker-v2-m3"

# LLM Settings
# LLM_PROVIDER="qwen"  # Options: "qwen" or "gemini"

# Local LLM (Qwen) Settings
# LOCAL_LLM_MODEL="Qwen/Qwen3-0.6B"
# LOCAL_LLM_MAX_TOKENS=1024
# LOCAL_LLM_TEMPERATURE=0.3

# Gemini Settings (required if using Gemini)
GOOGLE_API_KEY="YOUR_GOOGLE_API_KEY_HERE"
# GEMINI_MODEL="gemini-2.5-pro"
# GEMINI_MAX_TOKENS=1024
# GEMINI_TEMPERATURE=0.3

# Choose one or both providers
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Default model
DEFAULT_MODEL=claude-sonnet-4-20250514
# DEFAULT_MODEL=gpt-4o

# Logging
LOG_LEVEL=INFO

# AI Hook Logging (set by instructor)
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=lMfm8NPzHVHlOtYx2kOQ7c9PTxJOB0E3DJbD_UBlsFw
AI_LOG_DIR=.ai-log